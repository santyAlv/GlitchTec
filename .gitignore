# ============================================================
# Glitch.TEC — .gitignore
# ============================================================

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Logs y temporales
*.log
*.tmp
*.temp
.env
.env.local

# Dependencias (si más adelante se usa npm)
node_modules/
vendor/
!js/vendor/
composer.lock

# Exports locales de partidas
local_scores.json

# Caché de PHP
api/cache/
*.cache

# Datos del hosting (credenciales y destino SSH): nunca a git
api/config.local.php
tools/desplegar.env
