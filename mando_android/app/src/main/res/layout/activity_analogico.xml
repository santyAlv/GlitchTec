<?xml version="1.0" encoding="utf-8"?>
<!-- Medidas calculadas sobre el fondo (0,43 dp por px de la referencia) para una pantalla de ~866x387 dp -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/analogico"
    android:background="#02133A">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_mando"
        android:importantForAccessibility="no" />

    <!-- Joystick: base negra y perilla que se mueve -->
    <FrameLayout
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="166dp">

        <ImageView
            android:id="@+id/joystick_base"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:src="@drawable/joy_base"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/joystick_knob"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:layout_gravity="center"
            android:src="@drawable/joy_knob"
            android:contentDescription="Joystick" />
    </FrameLayout>

    <!-- Botones de clic: izquierdo (magenta) arriba, derecho (azul) abajo -->
    <FrameLayout
        android:id="@+id/btnIzq"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="565dp"
        android:layout_marginTop="37dp"
        android:contentDescription="Clic izquierdo">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/joy_base"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:src="@drawable/btn_magenta"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="58dp"
            android:layout_height="43dp"
            android:layout_gravity="center"
            android:rotation="-90"
            android:src="@drawable/ic_mouse_izq"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnDer"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="565dp"
        android:layout_marginTop="218dp"
        android:contentDescription="Clic derecho">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/joy_base"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:src="@drawable/btn_azul"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="58dp"
            android:layout_height="43dp"
            android:layout_gravity="center"
            android:rotation="-90"
            android:src="@drawable/ic_mouse_der"
            android:importantForAccessibility="no" />
    </FrameLayout>

</RelativeLayout>
