# Copiá este archivo como tools/desplegar.env (no va a git) y completalo.
# Usuario de cPanel y servidor: cPanel > Información de la cuenta, o el mail de bienvenida.
SSH_DESTINO=usuariocpanel@servidor.hostgator
# HostGator LatAm usa el 22; si no conecta, probá 2222.
SSH_PUERTO=22
# Carpeta del dominio dentro de tu home (la que eligió el cPanel al agregar el dominio).
CARPETA=glitchtec.dpdns.org
# Clave SSH autorizada en cPanel > Acceso SSH.
SSH_CLAVE=~/.ssh/glitchtec_hostgator
